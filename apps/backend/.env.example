STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-long-random-string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Search — Meilisearch (@rokmohar/medusa-plugin-meilisearch). Local dev:
#   docker run -d --name mowy-meilisearch -p 7700:7700 \
#     -e MEILI_MASTER_KEY=<pick-a-key> -e MEILI_NO_ANALYTICS=true \
#     -v meilisearch_data:/meili_data getmeili/meilisearch:v1.53
# MEILISEARCH_API_KEY is that MEILI_MASTER_KEY.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=replace-with-your-meilisearch-master-key

# File storage — Cloudinary provider (@tsc_tech/medusa-plugin-cloudinary/providers/file-cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible alternative — only needed if the file module is switched
# from Cloudinary to @medusajs/medusa/file-s3 (see medusa-config.ts). No
# extra install needed, it ships with @medusajs/medusa.
# Public base URL files are served from (e.g. https://<bucket>.s3.<region>.amazonaws.com,
# or your MinIO/Supabase Storage public endpoint).
# S3_FILE_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_BUCKET=
# API endpoint for the S3-compatible service. Leave unset for AWS S3 itself
# (it's inferred from the region); set for MinIO/Supabase/other S3-compatible hosts.
# S3_ENDPOINT=

# Payments — SumUp Hosted Checkout (@sumup/medusa-plugin). Sandbox
# credentials: SumUp Developer Portal > your sandbox merchant > API keys.
SUMUP_API_KEY=replace-with-your-sumup-api-key
SUMUP_MERCHANT_CODE=replace-with-your-sumup-merchant-code
# Used to build the SumUp returnUrl (backend webhook callback) — this
# machine's own publicly reachable URL, not the storefront's.
MEDUSA_BACKEND_URL=http://localhost:9000
# Used to build the SumUp redirectUrl the customer lands back on after
# Hosted Checkout / SCA.
STOREFRONT_URL=http://localhost:8000

# Shared with the storefront's REVALIDATE_SECRET (apps/storefront/.env.local)
# — must match exactly. Used by src/subscribers/product-changed.ts to
# authenticate calls to the storefront's /api/revalidate route so listing
# pages refresh after a product is created/updated/deleted in the admin.
REVALIDATE_SECRET=replace-with-a-long-random-string

# Email — Resend (src/modules/resend), the notification module's "email"
# channel. Only registered when RESEND_API_KEY is set (see medusa-config.ts);
# without it the backend still boots but nothing on that channel sends.
# Key: resend.com > API Keys. Until a sending domain is verified in Resend,
# the default from address below can only deliver to the email address that
# owns the Resend account.
RESEND_API_KEY=
# Optional. Must be on a domain verified in Resend, e.g. "MOWY <hello@yourdomain>".
RESEND_FROM_EMAIL=MOWY <onboarding@resend.dev>

# Contact form (src/api/contact-form/route.ts). CONTACT_FORM_SECRET must
# match the storefront's CONTACT_FORM_SECRET exactly — it's what stops
# anyone else using that route to send email. CONTACT_FORM_RECIPIENT is the
# inbox that receives every submission; it's only ever read from here,
# never from the request.
CONTACT_FORM_SECRET=replace-with-a-long-random-string
CONTACT_FORM_RECIPIENT=replace-with-the-shop-inbox-address
