--- a/.medusa/server/src/providers/sumup/service.js
+++ b/.medusa/server/src/providers/sumup/service.js
@@ -70,7 +70,7 @@ class SumUpPaymentProviderService extends utils_1.AbstractPaymentProvider {
         if (!transactionId) {
             throw new utils_1.MedusaError(utils_1.MedusaError.Types.INVALID_DATA, "Cannot refund SumUp payment without a successful transaction id.");
         }
-        await this.client_.refundTransaction(transactionId, (0, utils_2.toMajorUnitNumber)(amount));
+        await this.client_.refundTransaction(transactionId, (0, utils_2.toMajorUnitNumber)(amount, paymentData?.currency ?? nextData?.currency));
         return {
             data: nextData,
         };
@@ -109,7 +109,7 @@ class SumUpPaymentProviderService extends utils_1.AbstractPaymentProvider {
     async updatePayment(input) {
         const checkout = await this.retrieveProviderCheckout(input.data);
         const status = (0, utils_2.mapCheckoutToSessionStatus)(checkout);
-        const currentAmount = (0, utils_2.toMajorUnitNumber)(input.amount);
+        const currentAmount = (0, utils_2.toMajorUnitNumber)(input.amount, input.currency_code);
         const currentCurrency = input.currency_code.toUpperCase();
         if (checkout.amount === currentAmount &&
             checkout.currency === currentCurrency) {
